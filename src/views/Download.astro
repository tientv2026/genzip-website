---
// GenZip chỉ phát hành cho người dùng qua Microsoft Store — không có bộ cài/portable tải tự do.
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import { formatReleaseDate } from '../components/download/releases';
import { getLangFromUrl, localePath } from '../i18n/ui';
import { publisher, storeUrl } from '../data/product';
import { getCurrentRelease, getLatestRelease, isReleased } from '../data/releases';

const lang = getLangFromUrl(Astro.url);
const current = getLatestRelease('stable') ?? getCurrentRelease('beta');
const c = {
  vi: {
    title: 'Tải GenZip', lead: 'Miễn phí cho Windows 10 và 11 (64-bit), phát hành chính thức trên Microsoft Store.',
    version: 'Phiên bản', pending: 'Sắp phát hành',
    store: 'Bản chính thức của GenZip. Cài, cập nhật và gỡ đều qua Microsoft Store.',
    storeButton: 'Tải từ Microsoft Store', storeSoon: 'Sắp có trên Microsoft Store',
    publisher: 'Nhà phát hành',
    whyTitle: 'Vì sao chỉ phát hành qua Microsoft Store?',
    why: [
      'Gói cài đặt được Microsoft kiểm tra và ký số — không lo tải nhầm bản giả mạo.',
      'Microsoft Store tự cập nhật GenZip; ở bản Store, GenZip không tự kết nối mạng.',
      'Cài và gỡ sạch sẽ, kể cả menu chuột phải và liên kết định dạng tệp.',
      'Không cần quyền quản trị, không cần tài khoản GenZip.',
    ],
    requirements: 'Yêu cầu hệ thống', requirementItems: ['Windows 10 hoặc Windows 11, 64-bit (x64)', 'Có ứng dụng Microsoft Store'],
    other: 'macOS và Linux', otherText: 'Đang phát triển.', notes: 'Xem lịch sử phiên bản',
  },
  en: {
    title: 'Download GenZip', lead: 'Free for Windows 10 and 11 (64-bit), officially published on Microsoft Store.',
    version: 'Version', pending: 'Coming soon',
    store: 'The official GenZip release. Install, update and uninstall through Microsoft Store.',
    storeButton: 'Get it from Microsoft Store', storeSoon: 'Coming soon to Microsoft Store',
    publisher: 'Publisher',
    whyTitle: 'Why only Microsoft Store?',
    why: [
      'The package is checked and signed by Microsoft — no risk of fake downloads.',
      'Microsoft Store keeps GenZip up to date; the Store build never connects to the network by itself.',
      'Clean install and uninstall, including the right-click menu and file associations.',
      'No admin rights and no GenZip account needed.',
    ],
    requirements: 'System requirements', requirementItems: ['Windows 10 or Windows 11, 64-bit (x64)', 'Microsoft Store app'],
    other: 'macOS and Linux', otherText: 'In development.', notes: 'See release notes',
  },
}[lang];
---

<Base title={c.title} description={c.lead}>
  <PageHero title={c.title} lead={c.lead}>
    <p class="version muted">
      {c.version} {current.version} <span aria-hidden="true">·</span>
      {isReleased(current) ? <time datetime={current.date}>{formatReleaseDate(current.date!, lang)}</time> : c.pending}
    </p>
  </PageHero>
  <section class="section" aria-label={c.title}>
    <div class="container">
      <div class="store-layout">
        <article class="card card-raised store-card">
          <div class="card-heading"><Icon name="store" size={36} /></div>
          <h2>Microsoft Store</h2>
          <p class="muted">{c.store}</p>
          <dl class="facts">
            <dt>{c.version}</dt><dd>{current.version}</dd>
            <dt>{c.publisher}</dt><dd>{publisher}</dd>
          </dl>
          {storeUrl ? (
            <a class="btn btn-primary btn-lg" href={storeUrl} rel="noopener"><Icon name="windows" size={20} />{c.storeButton}</a>
          ) : (
            <button class="btn btn-primary btn-lg" disabled><Icon name="windows" size={20} />{c.storeSoon}</button>
          )}
        </article>
        <section class="card card-soft why" aria-labelledby="why-store">
          <h2 id="why-store">{c.whyTitle}</h2>
          <ul>{c.why.map((item) => <li><Icon name="check" size={20} /><span>{item}</span></li>)}</ul>
        </section>
      </div>
      <div class="info">
        <section class="card" aria-labelledby="requirements">
          <h2 id="requirements">{c.requirements}</h2>
          <ul class="plain">{c.requirementItems.map((item) => <li>{item}</li>)}</ul>
        </section>
        <section class="card" aria-labelledby="other-platforms">
          <h2 id="other-platforms">{c.other}</h2>
          <p class="muted">{c.otherText}</p>
        </section>
      </div>
      <p class="notes"><a href={localePath('/changelog', lang)}>{c.notes} →</a></p>
    </div>
  </section>
</Base>

<style>
  .version { margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .store-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 24px; align-items: stretch; }
  .store-card { display: flex; flex-direction: column; gap: 16px; min-width: 0; border-color: var(--primary); border-radius: var(--radius-lg); }
  .store-card h2 { font-size: 1.5rem; margin: 0; }
  .store-card p { margin: 0; }
  .store-card > .btn { margin-top: auto; align-self: flex-start; }
  .card-heading { color: var(--primary); }
  .facts { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 16px; margin: 0; font-size: 0.9rem; }
  dt { color: var(--text-muted); }
  dd { margin: 0; overflow-wrap: anywhere; }
  button:disabled { opacity: 0.7; cursor: default; }
  .why { border-radius: var(--radius-lg); }
  .why h2, .info h2 { font-size: 1.25rem; }
  .why ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .why li { display: flex; gap: 12px; align-items: flex-start; }
  .why li :global(svg) { flex-shrink: 0; margin-top: 2px; color: var(--primary); }
  .plain { margin: 0; padding-left: 20px; }
  .plain li + li { margin-top: 8px; }
  .info { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  .notes { text-align: center; margin: 32px 0 0; }
  @media (max-width: 900px) {
    .store-layout, .info { grid-template-columns: 1fr; }
    .store-card > .btn { align-self: stretch; }
  }
</style>
