---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, localePath, useTranslations } from '../i18n/ui';
import { release, storeUrl } from '../data/product';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pending = lang === 'vi' ? 'Sắp phát hành' : 'Not released yet';

const c = {
  vi: {
    title: 'Tải GenZip',
    lead: 'Miễn phí cho Windows 10 và 11 (64-bit).',
    cards: [
      { name: 'Microsoft Store', badge: 'Khuyên dùng', text: 'Tự cập nhật qua Store, được Microsoft ký số.', button: 'Mở trong Microsoft Store', href: storeUrl, file: null },
      { name: 'Bộ cài (.exe)', badge: null, text: 'Cài cho người dùng hiện tại, không cần quyền quản trị. Có menu chuột phải và tự kiểm tra cập nhật.', button: 'Tải .exe', href: release.installer.url, file: release.installer },
      { name: 'Bản portable (.zip)', badge: null, text: 'Giải nén và chạy, không cần cài. Không đăng ký menu chuột phải.', button: 'Tải .zip', href: release.portable.url, file: release.portable },
    ],
    req: 'Yêu cầu hệ thống',
    reqItems: ['Windows 10 hoặc Windows 11, 64-bit (x64)', 'Không cần .NET, không cần quyền quản trị'],
    verify: 'Kiểm tra tệp tải về',
    verifyText: 'So mã SHA-256 bên dưới với kết quả lệnh này trong PowerShell:',
    other: 'macOS và Linux',
    otherText: 'Đang phát triển. Kiến trúc GenZip đã sẵn sàng đa nền tảng.',
    notes: 'Xem lịch sử phiên bản',
    version: 'Phiên bản',
  },
  en: {
    title: 'Download GenZip',
    lead: 'Free for Windows 10 and 11 (64-bit).',
    cards: [
      { name: 'Microsoft Store', badge: 'Recommended', text: 'Automatic updates through the Store, signed by Microsoft.', button: 'Open in Microsoft Store', href: storeUrl, file: null },
      { name: 'Installer (.exe)', badge: null, text: 'Installs for the current user, no admin rights needed. Includes the right-click menu and update checks.', button: 'Download .exe', href: release.installer.url, file: release.installer },
      { name: 'Portable (.zip)', badge: null, text: 'Unzip and run, no installation. Does not register the right-click menu.', button: 'Download .zip', href: release.portable.url, file: release.portable },
    ],
    req: 'System requirements',
    reqItems: ['Windows 10 or Windows 11, 64-bit (x64)', 'No .NET, no admin rights required'],
    verify: 'Verify your download',
    verifyText: 'Compare the SHA-256 below with the output of this PowerShell command:',
    other: 'macOS and Linux',
    otherText: 'In development. GenZip is built to be cross-platform.',
    notes: 'See the changelog',
    version: 'Version',
  },
}[lang];
---

<Base title={t('nav.download')}>
  <section class="section">
    <div class="container">
      <header class="section-title">
        <h1>{c.title}</h1>
        <p class="muted">{c.lead}</p>
      </header>

      <div class="cards">
        {
          c.cards.map((card) => (
            <div class:list={['card', 'dl', { featured: card.badge }]}>
              <div class="dl-head">
                <h2>{card.name}</h2>
                {card.badge && <span class="chip">{card.badge}</span>}
              </div>
              <p class="muted">{card.text}</p>
              {card.file && (
                <dl class="facts">
                  <dt>{c.version}</dt>
                  <dd>{release.version}{card.file.size && ` · ${card.file.size}`}</dd>
                  <dt>SHA-256</dt>
                  <dd><code class="hash">{card.file.sha256 || '—'}</code></dd>
                </dl>
              )}
              {card.href ? (
                <a class:list={['btn', card.badge ? 'btn-primary' : 'btn-outline']} href={card.href}>{card.button}</a>
              ) : (
                <span class="btn btn-outline" aria-disabled="true">{pending}</span>
              )}
            </div>
          ))
        }
      </div>

      <div class="info">
        <div class="card">
          <h3>{c.req}</h3>
          <ul>{c.reqItems.map((r) => <li>{r}</li>)}</ul>
        </div>
        <div class="card">
          <h3>{c.verify}</h3>
          <p class="muted">{c.verifyText}</p>
          <pre><code>Get-FileHash .\GenZip-Setup.exe -Algorithm SHA256</code></pre>
        </div>
        <div class="card">
          <h3>{c.other}</h3>
          <p class="muted">{c.otherText}</p>
          <span class="chip chip-soon">{t('common.soon')}</span>
        </div>
      </div>

      <p class="notes"><a href={localePath('/changelog', lang)}>{c.notes} →</a></p>
    </div>
  </section>
</Base>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .dl {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .dl .btn {
    margin-top: auto;
  }
  .featured {
    border-color: var(--primary);
    box-shadow: var(--shadow);
  }
  .dl-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .dl-head h2 {
    font-size: 1.25rem;
    margin: 0;
  }
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 12px;
    margin: 0;
    font-size: 0.9rem;
  }
  dt {
    color: var(--text-muted);
  }
  dd {
    margin: 0;
    min-width: 0;
  }
  .hash {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  [aria-disabled='true'] {
    opacity: 0.6;
    cursor: default;
  }
  .info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 32px;
  }
  .info ul {
    padding-left: 20px;
    margin: 0;
  }
  .notes {
    text-align: center;
    margin-top: 32px;
  }
  @media (max-width: 900px) {
    .cards,
    .info {
      grid-template-columns: 1fr;
    }
  }
</style>
