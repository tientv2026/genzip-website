---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, localePath, useTranslations } from '../i18n/ui';
import { support } from '../data/product';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const c = {
  vi: {
    lead: 'Báo lỗi, góp ý hoặc hỏi về GenZip qua email. Khi báo lỗi, hãy gửi kèm phiên bản (Trợ giúp → Giới thiệu → Sao chép thông tin).',
    faq: 'Xem trước phần Hỏi đáp',
  },
  en: {
    lead: 'Report a bug, send feedback or ask about GenZip by email. For bugs, include your version (Help → About → Copy info).',
    faq: 'Check the FAQ first',
  },
}[lang];
---

<Base title={t('footer.contact')}>
  <section class="section">
    <div class="container narrow">
      <h1>{t('footer.contact')}</h1>
      <p class="muted">{c.lead}</p>
      <div class="card">
        <p><strong>Email:</strong> <a href={`mailto:${support.email}`}>{support.email}</a></p>
        <p><strong>Website:</strong> <a href={support.website}>{support.website.replace('https://', '')}</a></p>
      </div>
      <p><a href={localePath('/faq', lang)}>{c.faq} →</a></p>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 760px;
  }
  .card {
    margin: 24px 0;
  }
  .card p:last-child {
    margin: 0;
  }
</style>
