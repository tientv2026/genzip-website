---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, localePath, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const c = {
  vi: {
    title: 'Câu hỏi thường gặp',
    more: 'Không thấy câu trả lời?',
    contact: 'Liên hệ tác giả',
    items: [
      ['GenZip có thật sự miễn phí không?', 'Có. GenZip miễn phí, không quảng cáo, không bản trả phí ẩn. Nếu thấy hữu ích, bạn có thể ủng hộ tác giả.'],
      ['GenZip có tạo được tệp RAR không?', 'Không. RAR là định dạng độc quyền. GenZip đọc và giải nén được RAR4/RAR5, còn khi tạo nén thì dùng ZIP, 7z hoặc TAR.'],
      ['GenZip có gửi dữ liệu của tôi đi không?', 'Không. GenZip không có tài khoản, không telemetry, không gửi tệp hay tên tệp đi đâu. Bản tải trực tiếp chỉ kiểm tra cập nhật tối đa 1 lần/ngày và tắt được.'],
      ['Tôi quên mật khẩu tệp nén, GenZip mở được không?', 'Không. Mã hoá AES-256 không có “cửa sau”; GenZip không phá mật khẩu.'],
      ['Nên dùng ZIP hay 7z?', 'ZIP mở được ở mọi máy. 7z nén nhỏ hơn và mã hoá được cả tên tệp. Nếu đặt mật khẩu có dấu tiếng Việt, hãy dùng 7z.'],
      ['Dùng chung với WinRAR hoặc 7-Zip được không?', 'Được. GenZip chỉ đăng ký liên kết tệp và menu chuột phải cho tài khoản Windows hiện tại, bạn bật/tắt được trong Cài đặt → Tích hợp.'],
      ['Gỡ cài đặt có sạch không?', 'Có. Gỡ GenZip sẽ gỡ menu chuột phải và liên kết tệp. Dữ liệu cài đặt nằm trong thư mục dữ liệu ứng dụng của bạn.'],
      ['Khi nào có bản macOS và Linux?', 'Đang phát triển sau bản Windows 1.0.'],
    ],
  },
  en: {
    title: 'Frequently asked questions',
    more: 'Didn’t find your answer?',
    contact: 'Contact the author',
    items: [
      ['Is GenZip really free?', 'Yes. GenZip is free, with no ads and no hidden paid tier. If it helps you, you can support the author.'],
      ['Can GenZip create RAR files?', 'No. RAR is proprietary. GenZip opens and extracts RAR4/RAR5 and creates ZIP, 7z or TAR.'],
      ['Does GenZip collect my data?', 'No. No account, no telemetry, your files and file names never leave your PC. The direct-download build checks for updates at most once a day, and you can turn it off.'],
      ['I forgot my archive password — can GenZip open it?', 'No. AES-256 has no back door, and GenZip does not crack passwords.'],
      ['ZIP or 7z?', 'ZIP opens everywhere. 7z is smaller and can encrypt file names.'],
      ['Can I use GenZip alongside WinRAR or 7-Zip?', 'Yes. GenZip only registers file associations and the right-click menu for the current Windows user, and you can toggle them in Settings → Integration.'],
      ['Does uninstalling leave anything behind?', 'Uninstalling removes the right-click menu and file associations. Settings live in your app data folder.'],
      ['When will macOS and Linux arrive?', 'They are in development after Windows 1.0.'],
    ],
  },
}[lang];
---

<Base title={t('nav.faq')}>
  <section class="section">
    <div class="container narrow">
      <h1>{c.title}</h1>
      <div class="list">
        {
          c.items.map(([q, a], i) => (
            <details class="card item" open={i === 0}>
              <summary>{q}</summary>
              <p class="muted">{a}</p>
            </details>
          ))
        }
      </div>
      <p class="more">
        {c.more} <a href={localePath('/contact', lang)}>{c.contact} →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 820px;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 32px;
  }
  .item {
    padding: 0;
  }
  summary {
    cursor: pointer;
    padding: 18px 24px;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    color: var(--primary);
    font-size: 1.25rem;
    line-height: 1;
  }
  details[open] summary::after {
    content: '−';
  }
  .item p {
    padding: 0 24px 18px;
    margin: 0;
  }
  .more {
    margin-top: 32px;
  }
</style>
