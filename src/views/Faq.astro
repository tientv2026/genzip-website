---
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaCard from '../components/ui/CtaCard.astro';
import Icon from '../components/ui/Icon.astro';
import { getLangFromUrl, localePath, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = {
  vi: {
    title: 'Câu hỏi thường gặp',
    lead: 'Những điều cần biết để bắt đầu dùng GenZip một cách an tâm.',
    search: 'Tìm trong câu hỏi và câu trả lời',
    placeholder: 'Ví dụ: mật khẩu, Microsoft Store, cập nhật…',
    results: 'câu hỏi phù hợp',
    empty: 'Chưa tìm thấy câu hỏi phù hợp. Hãy thử từ khóa khác hoặc liên hệ tác giả.',
    more: 'Không thấy câu trả lời bạn cần?',
    contact: 'Liên hệ tác giả',
    groups: [
      { title: 'Chung', items: [
        ['GenZip có thật sự miễn phí không?', 'Có. GenZip miễn phí, không quảng cáo, không bản trả phí ẩn. Nếu thấy hữu ích, bạn có thể ủng hộ tác giả.'],
        ['GenZip có hỗ trợ tiếng Việt không?', 'Có. GenZip hỗ trợ tiếng Việt và tiếng Anh.'],
        ['Khi nào có bản macOS và Linux?', 'Đang phát triển, sau khi bản Windows ổn định.'],
      ] },
      { title: 'Định dạng', items: [
        ['GenZip có tạo được tệp RAR không?', 'Không. RAR là định dạng độc quyền. GenZip đọc và giải nén được RAR4/RAR5, còn khi tạo nén thì dùng ZIP, 7z hoặc TAR.'],
        ['Nên dùng ZIP hay 7z?', 'ZIP được hỗ trợ rộng rãi. 7z hỗ trợ nén gọn và mã hoá cả tên tệp. Nếu đặt mật khẩu có dấu tiếng Việt, hãy dùng 7z.'],
      ] },
      { title: 'Bảo mật & quyền riêng tư', items: [
        ['GenZip có gửi dữ liệu của tôi đi không?', 'Không. GenZip không có tài khoản, không telemetry, không gửi tệp hay tên tệp đi đâu. Bản Microsoft Store không tự kết nối mạng; việc cập nhật do Store đảm nhận.'],
        ['Tôi quên mật khẩu tệp nén, GenZip mở được không?', 'Không. Mã hoá AES-256 không có “cửa sau”; GenZip không phá mật khẩu.'],
      ] },
      { title: 'Cài đặt & cập nhật', items: [
        ['Tải GenZip ở đâu?', 'GenZip chỉ phát hành chính thức trên Microsoft Store. Không có bộ cài tải tự do, nên hãy cẩn thận với các trang khác tự nhận là nơi tải GenZip.'],
        ['GenZip cập nhật như thế nào?', 'Microsoft Store tự tải và cài bản mới. Xem có gì mới ở trang Lịch sử phiên bản.'],
        ['Dùng chung với phần mềm nén khác được không?', 'Được. GenZip chỉ đăng ký liên kết tệp và menu chuột phải cho tài khoản Windows hiện tại, bạn bật/tắt được trong Cài đặt → Tích hợp.'],
        ['Gỡ cài đặt có sạch không?', 'Có. Gỡ GenZip sẽ gỡ menu chuột phải và liên kết tệp. Dữ liệu cài đặt nằm trong thư mục dữ liệu ứng dụng của bạn.'],
      ] },
    ],
  },
  en: {
    title: 'Frequently asked questions',
    lead: 'A few things to know before getting started with GenZip.',
    search: 'Search questions and answers',
    placeholder: 'Try: password, Microsoft Store, updates…',
    results: 'matching questions',
    empty: 'No matching questions yet. Try another search or contact the author.',
    more: 'Didn’t find the answer you need?',
    contact: 'Contact the author',
    groups: [
      { title: 'General', items: [
        ['Is GenZip really free?', 'Yes. GenZip is free, with no ads and no hidden paid tier. If it helps you, you can support the author.'],
        ['Does GenZip support Vietnamese?', 'Yes. GenZip supports Vietnamese and English.'],
        ['When will macOS and Linux arrive?', 'They are in development, after the Windows release is stable.'],
      ] },
      { title: 'Formats', items: [
        ['Can GenZip create RAR files?', 'No. RAR is proprietary. GenZip opens and extracts RAR4/RAR5 and creates ZIP, 7z or TAR.'],
        ['ZIP or 7z?', 'ZIP is widely supported. 7z supports compact archives and file name encryption. Use 7z if your password includes Vietnamese diacritics.'],
      ] },
      { title: 'Security & privacy', items: [
        ['Does GenZip collect my data?', 'No. No account, no telemetry, your files and file names never leave your PC. The Microsoft Store build never connects to the network by itself; updates are handled by the Store.'],
        ['I forgot my archive password — can GenZip open it?', 'No. AES-256 has no back door, and GenZip does not crack passwords.'],
      ] },
      { title: 'Installation & updates', items: [
        ['Where do I get GenZip?', 'GenZip is only officially published on Microsoft Store. There is no free-floating installer, so be careful with other sites claiming to offer GenZip downloads.'],
        ['How does GenZip update?', 'Microsoft Store downloads and installs new versions. See what changed on the Release notes page.'],
        ['Can I use GenZip alongside other archive managers?', 'Yes. GenZip only registers file associations and the right-click menu for the current Windows user, and you can toggle them in Settings → Integration.'],
        ['Does uninstalling leave anything behind?', 'Uninstalling removes the right-click menu and file associations. Settings live in your app data folder.'],
      ] },
    ],
  },
}[lang];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: c.groups.flatMap((group) => group.items.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  }))),
};
---

<Base title={t('nav.faq')} description={c.lead}>
  <PageHero eyebrow={t('nav.faq')} title={c.title} lead={c.lead} />
  <section class="section">
    <div class="container faq-content" data-faq data-results={c.results}>
      <div class="search-panel card card-soft" data-search-panel hidden>
        <label for="faq-search">{c.search}</label>
        <div class="search-field">
          <Icon name="search" size={20} />
          <input id="faq-search" type="search" placeholder={c.placeholder} aria-controls="faq-groups" autocomplete="off" />
        </div>
        <p class="search-status muted" role="status" aria-live="polite" data-search-status></p>
      </div>
      <div id="faq-groups">
        {c.groups.map((group, index) => (
          <section class="faq-group" data-faq-group aria-labelledby={`faq-topic-${index}`}>
            <h2 id={`faq-topic-${index}`}>{group.title}</h2>
            {group.items.map(([q, a]) => (
              <details class="faq-item" data-faq-item>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
          </section>
        ))}
      </div>
      <p class="card muted" data-search-empty hidden>{c.empty}</p>
      <p class="more">{c.more} <a href={localePath('/contact', lang)}>{c.contact} →</a></p>
      <CtaCard />
    </div>
  </section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
</Base>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-faq]');
    if (!root) return;
    const input = root.querySelector('#faq-search');
    const status = root.querySelector('[data-search-status]');
    const empty = root.querySelector('[data-search-empty]');
    const normalize = (value) => value.toLocaleLowerCase().normalize('NFD').replace(/\p{M}/gu, '').replace(/đ/g, 'd');
    const items = Array.from(root.querySelectorAll('[data-faq-item]')).map((item) => ({
      item,
      text: normalize(item.textContent || ''),
    }));
    const groups = Array.from(root.querySelectorAll('[data-faq-group]'));
    root.querySelector('[data-search-panel]').hidden = false;
    input.addEventListener('input', () => {
      const words = normalize(input.value.trim()).split(/\s+/).filter(Boolean);
      let count = 0;
      items.forEach(({ item, text }) => {
        const matches = words.every((word) => text.includes(word));
        item.hidden = !matches;
        item.open = words.length > 0 && matches;
        if (matches) count++;
      });
      groups.forEach((group) => {
        group.hidden = !Array.from(group.querySelectorAll('[data-faq-item]')).some((item) => !item.hidden);
      });
      empty.hidden = count > 0;
      status.textContent = words.length ? `${count} ${root.dataset.results}` : '';
    });
  })();
</script>

<style>
  .faq-content { max-width: 960px; }
  .search-panel { margin-bottom: 40px; }
  label { display: block; margin-bottom: 10px; font-weight: 600; }
  .search-field { position: relative; }
  .search-field :global(svg) { position: absolute; left: 16px; top: 16px; color: var(--text-muted); }
  input { width: 100%; min-height: 52px; padding: 12px 16px 12px 48px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text); font: inherit; }
  input::placeholder { color: var(--text-muted); opacity: 1; }
  .search-status { margin: 10px 0 0; font-size: 0.875rem; }
  .search-status:empty { display: none; }
  .faq-group { margin-bottom: 36px; }
  .faq-group h2 { font-size: 1.375rem; margin-bottom: 16px; }
  .more { margin: 40px 0; }
</style>
