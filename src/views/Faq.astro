---
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaCard from '../components/ui/CtaCard.astro';
import Icon from '../components/ui/Icon.astro';
import { getLangFromUrl, localePath, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = {
  vi: {
    title: 'Câu hỏi thường gặp',
    lead: 'Những điều cần biết để bắt đầu dùng GenZip một cách an tâm.',
    search: 'Tìm trong câu hỏi và câu trả lời',
    placeholder: 'Ví dụ: mật khẩu, Microsoft Store, cập nhật…',
    results: 'câu hỏi phù hợp',
    empty: 'Chưa tìm thấy câu hỏi phù hợp. Hãy thử từ khóa khác hoặc liên hệ tác giả.',
    more: 'Không thấy câu trả lời bạn cần?',
    contact: 'Liên hệ tác giả',
    groups: [
      { title: 'Chung', items: [
        ['GenZip có thật sự miễn phí không?', 'Có. GenZip miễn phí, không quảng cáo. Bạn có thể ủng hộ tác giả qua mục Trợ giúp → Ủng hộ tác giả.'],
        ['GenZip có hỗ trợ tiếng Việt không?', 'Có. GenZip hỗ trợ tiếng Việt và tiếng Anh.'],
        ['Khi nào có bản macOS và Linux?', 'Sắp có. GenZip 0.9.0-beta.1 hiện dành cho Windows 10/11.'],
      ] },
      { title: 'Định dạng', items: [
        ['GenZip có tạo được tệp RAR không?', 'Không. GenZip đọc và giải nén RAR/RAR5, còn khi tạo nén thì dùng ZIP, 7Z hoặc TAR. Có thể tạo tệp .exe tự giải nén từ 7Z không chia phần.'],
        ['ZIP và 7Z có những tuỳ chọn mã hoá nào?', 'ZIP hỗ trợ ZipCrypto hoặc AES-256. 7Z hỗ trợ AES-256 và tuỳ chọn Ẩn tên tệp (7Z) trong cột Bảo mật của hộp thoại tạo nén.'],
        ['GenZip có sửa được tệp nén hỏng không?', 'Sắp có. Phiên bản 0.9.0-beta.1 có kiểm tra toàn vẹn và xuất báo cáo .txt; chưa có sửa chữa tệp nén hỏng.'],
      ] },
      { title: 'Bảo mật & quyền riêng tư', items: [
        ['GenZip có yêu cầu tài khoản hoặc telemetry không?', 'Không. GenZip không yêu cầu tài khoản và không có telemetry. Việc cập nhật do Microsoft Store cung cấp.'],
        ['GenZip bảo vệ khi giải nén như thế nào?', 'GenZip chặn đường dẫn nguy hiểm và tên thiết bị, giới hạn số mục, tỉ lệ nở, dung lượng và độ sâu giải nén, đồng thời giữ Mark of the Web.'],
      ] },
      { title: 'Cài đặt & cập nhật', items: [
        ['Tải GenZip ở đâu?', 'GenZip được phân phối qua Microsoft Store. Bản tải tự do: Sắp có.'],
        ['GenZip cập nhật như thế nào?', 'Microsoft Store cung cấp các bản cập nhật. Trang Cập nhật trong GenZip chỉ hiển thị thông báo này, không có lựa chọn kênh hoặc nút kiểm tra bản mới.'],
        ['Chọn GenZip làm ứng dụng mặc định như thế nào?', 'Mở Cài đặt Windows → Ứng dụng → Ứng dụng mặc định và chọn GenZip cho định dạng bạn muốn mở. Windows không cho ứng dụng tự đặt mình làm mặc định.'],
        ['Bật menu chuột phải ở đâu?', 'Menu chuột phải và liên kết tệp có sẵn trong gói Store. Trang Tích hợp ghi Windows quản lý cho bản Microsoft Store. GenZip có các lệnh trong menu chuột phải cấp một của Windows 11.'],
      ] },
      { title: 'Thao tác', items: [
        ['Chạy nền nằm ở đâu?', 'Chạy nền là nút trong cửa sổ tiến trình, xuất hiện sau khi bắt đầu thao tác. Nút này thu nhỏ cửa sổ và hiển thị phần trăm trên biểu tượng taskbar. Cửa sổ tiến trình cũng có Tạm dừng/Tiếp tục và Huỷ.'],
      ] },
    ],
  },
  en: {
    title: 'Frequently asked questions',
    lead: 'A few things to know before getting started with GenZip.',
    search: 'Search questions and answers',
    placeholder: 'Try: password, Microsoft Store, updates…',
    results: 'matching questions',
    empty: 'No matching questions yet. Try another search or contact the author.',
    more: 'Didn’t find the answer you need?',
    contact: 'Contact the author',
    groups: [
      { title: 'General', items: [
        ['Is GenZip really free?', 'Yes. GenZip is free, with no ads. You can support the author through Help → Support the author.'],
        ['Does GenZip support Vietnamese?', 'Yes. GenZip supports Vietnamese and English.'],
        ['When will macOS and Linux arrive?', 'Coming soon. GenZip 0.9.0-beta.1 is currently for Windows 10/11.'],
      ] },
      { title: 'Formats', items: [
        ['Can GenZip create RAR files?', 'No. GenZip reads and extracts RAR/RAR5 and creates ZIP, 7Z or TAR. It can also create a self-extracting .exe from 7Z without split volumes.'],
        ['What encryption options do ZIP and 7Z offer?', 'ZIP supports ZipCrypto or AES-256. 7Z supports AES-256 and Hide file names (7Z) in the Security column of the creation dialog.'],
        ['Can GenZip repair damaged archives?', 'Coming soon. Version 0.9.0-beta.1 offers integrity testing and .txt report export; archive repair is not available yet.'],
      ] },
      { title: 'Security & privacy', items: [
        ['Does GenZip require an account or include telemetry?', 'No. GenZip requires no account and has no telemetry. Microsoft Store provides updates.'],
        ['How does GenZip protect extraction?', 'GenZip blocks dangerous paths and device names, limits entry count, expansion ratio, extraction size and depth, and preserves Mark of the Web.'],
      ] },
      { title: 'Installation & updates', items: [
        ['Where do I get GenZip?', 'GenZip is distributed through Microsoft Store. Standalone downloads: Coming soon.'],
        ['How does GenZip update?', 'Microsoft Store provides updates. The Updates page in GenZip only shows this notice, with no channel selection or update check button.'],
        ['How do I make GenZip the default app?', 'Open Windows Settings → Apps → Default apps and choose GenZip for the formats you want to open. Windows does not let apps make themselves the default.'],
        ['Where do I enable the right-click menu?', 'The right-click menu and file associations are included in the Store package. Integration says Managed by Windows for the Microsoft Store build. GenZip provides commands in the top-level Windows 11 right-click menu.'],
      ] },
      { title: 'Operations', items: [
        ['Where is Run in background?', 'Run in background is a button in the progress window after an operation starts. It minimizes the window and shows the percentage on the taskbar icon. The progress window also offers Pause/Resume and Cancel.'],
      ] },
    ],
  },
}[lang];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: c.groups.flatMap((group) => group.items.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  }))),
};
---

<Base title={t('nav.faq')} description={c.lead}>
  <PageHero eyebrow={t('nav.faq')} title={c.title} lead={c.lead} />
  <section class="section">
    <div class="container faq-content" data-faq data-results={c.results}>
      <div class="search-panel card card-soft" data-search-panel hidden>
        <label for="faq-search">{c.search}</label>
        <div class="search-field">
          <Icon name="search" size={20} />
          <input id="faq-search" type="search" placeholder={c.placeholder} aria-controls="faq-groups" autocomplete="off" />
        </div>
        <p class="search-status muted" role="status" aria-live="polite" data-search-status></p>
      </div>
      <div id="faq-groups">
        {c.groups.map((group, index) => (
          <section class="faq-group" data-faq-group aria-labelledby={`faq-topic-${index}`}>
            <h2 id={`faq-topic-${index}`}>{group.title}</h2>
            {group.items.map(([q, a]) => (
              <details class="faq-item" data-faq-item>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
          </section>
        ))}
      </div>
      <p class="card muted" data-search-empty hidden>{c.empty}</p>
      <p class="more">{c.more} <a href={localePath('/contact', lang)}>{c.contact} →</a></p>
      <CtaCard />
    </div>
  </section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
</Base>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-faq]');
    if (!root) return;
    const input = root.querySelector('#faq-search');
    const status = root.querySelector('[data-search-status]');
    const empty = root.querySelector('[data-search-empty]');
    const normalize = (value) => value.toLocaleLowerCase().normalize('NFD').replace(/\p{M}/gu, '').replace(/đ/g, 'd');
    const items = Array.from(root.querySelectorAll('[data-faq-item]')).map((item) => ({
      item,
      text: normalize(item.textContent || ''),
    }));
    const groups = Array.from(root.querySelectorAll('[data-faq-group]'));
    root.querySelector('[data-search-panel]').hidden = false;
    input.addEventListener('input', () => {
      const words = normalize(input.value.trim()).split(/\s+/).filter(Boolean);
      let count = 0;
      items.forEach(({ item, text }) => {
        const matches = words.every((word) => text.includes(word));
        item.hidden = !matches;
        item.open = words.length > 0 && matches;
        if (matches) count++;
      });
      groups.forEach((group) => {
        group.hidden = !Array.from(group.querySelectorAll('[data-faq-item]')).some((item) => !item.hidden);
      });
      empty.hidden = count > 0;
      status.textContent = words.length ? `${count} ${root.dataset.results}` : '';
    });
  })();
</script>

<style>
  .faq-content { max-width: 960px; }
  .search-panel { margin-bottom: 40px; }
  label { display: block; margin-bottom: 10px; font-weight: 600; }
  .search-field { position: relative; }
  .search-field :global(svg) { position: absolute; left: 16px; top: 16px; color: var(--text-muted); }
  input { width: 100%; min-height: 52px; padding: 12px 16px 12px 48px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text); font: inherit; }
  input::placeholder { color: var(--text-muted); opacity: 1; }
  .search-status { margin: 10px 0 0; font-size: 0.875rem; }
  .search-status:empty { display: none; }
  .faq-group { margin-bottom: 36px; }
  .faq-group h2 { font-size: 1.375rem; margin-bottom: 16px; }
  .more { margin: 40px 0; }
</style>
