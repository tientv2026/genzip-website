---
import Base from '../layouts/Base.astro';
import FeatureGroup from '../components/features/FeatureGroup.astro';
import FormatMatrix from '../components/features/FormatMatrix.astro';
import FeatureGrid from '../components/features/FeatureGrid.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
type Card = { icon: string; title: string; text: string };
type Group = {
  id: string;
  icon: string;
  title: string;
  lead: string;
  screenshot?: 'main' | 'preview-image' | 'create' | 'extract' | 'queue' | 'test-result';
  alt?: string;
  items: Card[];
};

const c = {
  vi: {
    eyebrow: 'TÍNH NĂNG · 0.9.0-beta.1',
    title: 'Làm việc với tệp nén, từ đầu đến cuối',
    lead: 'Tham chiếu tính năng của GenZip 0.9.0-beta.1, bản Microsoft Store: mở, duyệt, chỉnh sửa, tạo và giải nén trong một giao diện quen thuộc.',
    toc: 'Trong trang này',
    formatsTitle: 'Định dạng được hỗ trợ',
