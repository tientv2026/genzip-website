---
import Base from '../layouts/Base.astro';
import Screenshot from '../components/Screenshot.astro';
import FeatureGrid from '../components/features/FeatureGrid.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CtaCard from '../components/ui/CtaCard.astro';
import Icon from '../components/ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Group = { id: string; title: string; items: string[] };

const c = {
  vi: {
    eyebrow: 'TÍNH NĂNG',
    title: 'Mọi thứ bạn cần để làm việc với tệp nén',
    lead: 'Danh sách dưới đây chỉ gồm những gì GenZip đã làm được. Tính năng chưa xong được ghi rõ “Sắp có”.',
    noRar: 'GenZip đọc và giải nén được RAR nhưng không tạo tệp RAR (RAR là định dạng độc quyền).',
    soonTitle: 'Sắp có',
    soon: ['macOS', 'Linux', 'Tăng tốc nhờ RAM: đọc trước tới 100 MB, dùng tối đa 35% RAM trống'],
    jumpLabel: 'Đi tới nhóm tính năng',
    available: 'Đang có trong GenZip',
    rarTitle: 'Đọc RAR, tạo ZIP, 7z và TAR',
    soonLead: 'Những tính năng đang được lên kế hoạch, chưa có trong phiên bản hiện tại.',
    shots: ['GenZip đang mở và duyệt nội dung tệp nén', 'Hộp thoại chọn thư mục đích và tùy chọn giải nén trong GenZip', 'Hộp thoại tạo tệp nén và các tùy chọn nén trong GenZip'],
    cardTitles: {
      security: ['Mã hóa AES-256', 'Mật khẩu riêng tư', 'Giải nén an toàn', 'Engine tách biệt', 'Giữ cảnh báo Internet'],
      progress: ['Hàng đợi tác vụ', 'Tiến độ rõ ràng', 'Tạm dừng thật', 'Theo dõi khi chạy nền', 'Dừng khi cần'],
      windows: ['Menu chuột phải', 'Mở bằng nhấp đúp', 'Một cửa sổ làm việc', 'Hỗ trợ tiếp cận'],
      personal: ['Sáng, tối, hệ thống', 'Màu nhấn của bạn', 'Sắp xếp không gian', 'Hai ngôn ngữ'],
      updates: ['Qua Microsoft Store', 'Không tự kết nối mạng', 'Microsoft ký số', 'Xem có gì mới'],
      cli: ['Mở tệp nén', 'Giải nén', 'Tạo tệp nén', 'Kiểm tra tệp nén', 'Xem phiên bản'],
    } as Record<string, string[]>,
    cliLead: 'Mở, giải nén, tạo và kiểm tra tệp nén từ dòng lệnh.',
    cliLabel: 'Các lệnh GenZip',
    cliDescriptions: ['Mở tệp nén từ đường dẫn.', 'Giải nén bằng lệnh x hoặc e.', 'Tạo nén với tùy chọn --quick zip|7z.', 'Kiểm tra tệp nén bằng lệnh t.', 'Hiển thị phiên bản GenZip.'],
    groups: [
      { id: 'open', title: 'Mở & xem', items: ['ZIP, 7z, RAR4/RAR5 (kể cả header mã hoá), TAR, GZ, BZ2, XZ, ZST, ISO, CAB, WIM', 'Tệp chia phần .7z.001, .part1.rar — báo rõ khi thiếu phần', 'Màn Home: kéo-thả, tệp gần đây, Tạo/Mở nhanh', 'Thanh địa chỉ, Back/Forward/Up, tìm trong tệp nén', 'Lọc theo loại: Thư mục, Tài liệu, Ảnh, Video, Âm thanh, Khác', 'Thống kê: số thư mục/tệp, tỉ lệ nén, trạng thái mã hoá', 'Bảng nhiều cột sắp xếp được, chọn nhiều mục', 'Xem trước ảnh và văn bản ngay trong tệp nén', 'Ưa thích và tệp gần đây', 'Hỏi lại trước khi mở tệp có rủi ro (exe, script…)'] },
      { id: 'extract', title: 'Giải nén', items: ['Tất cả / mục đã chọn / thư mục con', 'Thư mục đích có lịch sử, tạo thư mục theo tên tệp nén', 'Tệp trùng: Hỏi / Ghi đè / Bỏ qua / Tự đổi tên', 'Giữ cấu trúc thư mục, mở thư mục đích khi xong', 'Kiểm tra lại sau khi giải nén', 'Kiểm tra toàn vẹn tệp nén, xuất báo cáo', '“Giải nén tại đây” ra thư mục con cạnh tệp nén'] },
      { id: 'create', title: 'Tạo nén', items: ['Định dạng ZIP, 7z, TAR', 'Mức nén, phương thức, kích thước từ điển, solid (7z)', 'Chia volume theo KB/MB/GB', 'Preset: Thông thường, Tối đa, Nhanh, Lưu trữ', 'Tạo tệp tự giải nén .exe (định dạng 7Z)', 'Sửa tệp nén đang mở: thêm, xoá, đổi tên mục; kéo thả tệp vào cửa sổ'] },
      { id: 'security', title: 'Bảo mật', items: ['Mật khẩu AES-256, mã hoá cả tên tệp với 7z', 'Mật khẩu không bao giờ ghi xuống đĩa hay nhật ký', 'Chặn đường dẫn độc hại (../, đường dẫn tuyệt đối, tên thiết bị Windows)', 'Engine 7-Zip chạy trong tiến trình riêng, kiểm tra mã băm', 'Giữ cảnh báo “tệp tải từ Internet” (Mark-of-the-Web) cho tệp giải nén'] },
      { id: 'progress', title: 'Tiến trình', items: ['Hàng đợi tác vụ: xếp nhiều việc nén/giải nén chạy lần lượt', '% theo dung lượng thật, tốc độ, thời gian còn lại', 'Tạm dừng thật — không đọc/ghi, không tốn CPU', 'Chạy nền, tiến độ trên thanh taskbar', 'Huỷ tức thì, màn kết quả có nút Mở thư mục'] },
      { id: 'windows', title: 'Tích hợp Windows', items: ['Menu chuột phải Windows 11 và Windows 10, dạng gộp hoặc phẳng', 'Liên kết định dạng tệp, mở bằng double-click', 'Chỉ một cửa sổ chạy (single-instance)', 'DPI 100–200%, High Contrast, trình đọc màn hình'] },
      { id: 'personal', title: 'Cá nhân hoá', items: ['Sáng / Tối / Theo hệ thống', '9 màu nhấn', 'Chọn cột hiển thị, giới hạn lịch sử', 'Tiếng Việt và tiếng Anh'] },
      { id: 'updates', title: 'Cập nhật', items: ['Microsoft Store tự tải và cài bản mới', 'Bản Store không tự kết nối mạng', 'Gói cài đặt do Microsoft kiểm tra và ký số', 'Ghi chú từng phiên bản ở trang Lịch sử phiên bản'] },
      { id: 'cli', title: 'Dòng lệnh', items: ['genzip <tệp> — mở tệp nén', 'genzip x / e — giải nén', 'genzip a [--quick zip|7z] — tạo nén', 'genzip t — kiểm tra', 'genzip --version'] },
    ] as Group[],
  },
  en: {
    eyebrow: 'FEATURES',
    title: 'Everything you need to handle archives',
    lead: 'This list only contains what GenZip already does. Unfinished features are marked “Coming soon”.',
    noRar: 'GenZip opens and extracts RAR but does not create RAR files (RAR is a proprietary format).',
    soonTitle: 'Coming soon',
    soon: ['macOS', 'Linux', 'Faster with RAM: read ahead up to 100 MB, using at most 35% of free RAM'],
    jumpLabel: 'Jump to a feature group',
    available: 'Available in GenZip',
    rarTitle: 'Read RAR, create ZIP, 7z and TAR',
    soonLead: 'Planned features, not yet available in the current version.',
    shots: ['GenZip opening and browsing the contents of an archive', 'GenZip extraction dialog with destination and extraction options', 'GenZip archive creation dialog with compression options'],
    cardTitles: {
      security: ['AES-256 encryption', 'Private passwords', 'Safe extraction', 'Separate engine', 'Internet warnings kept'],
      progress: ['Task queue', 'Clear progress', 'Real pause', 'Background progress', 'Stop when needed'],
      windows: ['Right-click menu', 'Double-click to open', 'One workspace', 'Accessibility'],
      personal: ['Light, dark, system', 'Your accent color', 'Your workspace', 'Two languages'],
      updates: ['Via Microsoft Store', 'No network by itself', 'Signed by Microsoft', 'See what’s new'],
      cli: ['Open an archive', 'Extract', 'Create an archive', 'Test an archive', 'Show version'],
    } as Record<string, string[]>,
    cliLead: 'Open, extract, create and test archives from the command line.',
    cliLabel: 'GenZip commands',
    cliDescriptions: ['Open an archive from its path.', 'Extract using the x or e command.', 'Create with the --quick zip|7z option.', 'Test an archive using the t command.', 'Display the GenZip version.'],
    groups: [
      { id: 'open', title: 'Open & browse', items: ['ZIP, 7z, RAR4/RAR5 (including encrypted headers), TAR, GZ, BZ2, XZ, ZST, ISO, CAB, WIM', 'Split archives .7z.001, .part1.rar — tells you when a part is missing', 'Home screen: drag & drop, recent files, quick Create/Open', 'Address bar, Back/Forward/Up, search inside the archive', 'Filter by type: Folders, Documents, Images, Video, Audio, Other', 'Stats: folders/files, compression ratio, encryption state', 'Sortable multi-column table, multi-select', 'Preview images and text inside archives', 'Favorites and recent files', 'Asks before opening risky files (exe, scripts…)'] },
      { id: 'extract', title: 'Extract', items: ['All / selected / subfolder', 'Destination history, folder named after the archive', 'Existing files: Ask / Overwrite / Skip / Auto-rename', 'Keep folder structure, open destination when done', 'Verify after extraction', 'Integrity test with exportable report', '“Extract here” into a subfolder next to the archive'] },
      { id: 'create', title: 'Create', items: ['ZIP, 7z, TAR', 'Level, method, dictionary size, solid (7z)', 'Split into KB/MB/GB volumes', 'Presets: Normal, Maximum, Fast, Store', 'Create self-extracting .exe archives (7Z format)', 'Edit open archives: add, delete and rename items; drag and drop files into the window'] },
      { id: 'security', title: 'Security', items: ['AES-256 passwords, file-name encryption with 7z', 'Passwords are never written to disk or logs', 'Blocks malicious paths (../, absolute paths, Windows device names)', 'The 7-Zip engine runs in a separate, hash-pinned process', 'Keeps the “downloaded from the Internet” mark (Mark-of-the-Web) on extracted files'] },
      { id: 'progress', title: 'Progress', items: ['Task queue: line up several compress/extract jobs', 'Real byte-based %, speed, time left', 'Real pause — no reads/writes, no CPU', 'Background mode with taskbar progress', 'Instant cancel, result screen with Open folder'] },
      { id: 'windows', title: 'Windows integration', items: ['Windows 11 and Windows 10 right-click menus, cascaded or flat', 'File associations, double-click to open', 'Single instance', 'DPI 100–200%, High Contrast, screen readers'] },
      { id: 'personal', title: 'Personalize', items: ['Light / Dark / System', '9 accent colors', 'Choose columns, history limit', 'Vietnamese and English'] },
      { id: 'updates', title: 'Updates', items: ['Microsoft Store downloads and installs new versions', 'The Store build never connects to the network by itself', 'The package is checked and signed by Microsoft', 'Notes for every version on the Release notes page'] },
      { id: 'cli', title: 'Command line', items: ['genzip <file> — open an archive', 'genzip x / e — extract', 'genzip a [--quick zip|7z] — create', 'genzip t — test', 'genzip --version'] },
    ] as Group[],
  },
}[lang];
const screenshots = ['main', 'extract', 'create'] as const;
const groupIcons: Record<string, string> = {
  open: 'folder', extract: 'download', create: 'file', security: 'shield',
  progress: 'bolt', windows: 'windows', personal: 'sun', updates: 'download', cli: 'gear',
};
const featureIcons: Record<string, string[]> = {
  security: ['lock', 'key', 'shield', 'gear', 'file'],
  progress: ['split', 'bolt', 'minus', 'windows', 'folder'],
  windows: ['menu', 'file', 'windows', 'eye'],
  personal: ['moon', 'sun', 'gear', 'file'],
  updates: ['store', 'lock', 'shield', 'file'],
};
const commands = c.groups[8].items.map((item) => item.split(' — ')[0]);
---

<Base title={t('nav.features')} description={c.lead}>
  <PageHero eyebrow={c.eyebrow} title={c.title} lead={c.lead} />

  <div class="container">
    <nav class="quick-jumps" aria-label={c.jumpLabel}>
      {c.groups.map((g) => (
        <a class="pill-btn" href={`#${g.id}`}><Icon name={groupIcons[g.id]} size={18} />{g.title}</a>
      ))}
      <a class="pill-btn" href="#soon"><Icon name="plus" size={18} />{c.soonTitle}</a>
    </nav>
  </div>

  {c.groups.slice(0, 3).map((g, i) => (
    <section id={g.id} class:list={['section feature-section', { band: i === 1 }]}>
      <div class:list={['container feature-row', { reversed: i === 1 }]}>
        <div class="feature-copy">
          <SectionHeading eyebrow={c.available} title={g.title} align="left" />
          <ul class="feature-list">
            {g.items.map((item) => <li><Icon name="check" size={18} /><span>{item}</span></li>)}
          </ul>
        </div>
        <div class="feature-visual">
          <Screenshot name={screenshots[i]} alt={c.shots[i]} />
        </div>
      </div>
    </section>
  ))}

  {c.groups.slice(3, 8).map((g, i) => (
    <section id={g.id} class:list={['section feature-section', { band: i % 2 === 0 }]}>
      <div class="container">
        <SectionHeading title={g.title} align="left" />
        <FeatureGrid items={g.items.map((text, index) => ({
          icon: featureIcons[g.id][index],
          title: c.cardTitles[g.id][index],
          text,
        }))} />
      </div>
    </section>
  ))}

  <section id="cli" class="section feature-section">
    <div class="container">
      <SectionHeading title={c.groups[8].title} lead={c.cliLead} align="left" />
      <div class="command-layout">
        <FeatureGrid items={c.cardTitles.cli.map((title, i) => ({ icon: 'gear', title, text: c.cliDescriptions[i] }))} />
        <div class="command-panel card card-raised">
          <div class="command-heading"><Icon name="gear" size={20} /><span>{c.cliLabel}</span></div>
          <pre tabindex="0" aria-label={c.cliLabel}><code>{commands.map((command, i) => `# ${c.cardTitles.cli[i]}\n${command}`).join('\n\n')}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <div class="container closing-sections">
    <aside class="rar-note card card-soft">
      <span class="icon-badge"><Icon name="file" /></span>
      <div><h2>{c.rarTitle}</h2><p class="muted">{c.noRar}</p></div>
    </aside>
    <section id="soon" class="soon-section">
      <SectionHeading title={c.soonTitle} lead={c.soonLead} align="left" />
      <ul class="soon">{c.soon.map((s) => <li class="chip chip-soon">{s}</li>)}</ul>
    </section>
    <CtaCard />
  </div>
</Base>

<style>
  .quick-jumps { display: flex; flex-wrap: wrap; gap: 10px; padding-block: 28px; }
  .quick-jumps .pill-btn { border-radius: 999px; background: var(--surface); }
  .feature-section, .soon-section { scroll-margin-top: 96px; }
  .feature-row { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr); gap: 48px; align-items: center; }
  .feature-copy, .feature-visual { min-width: 0; }
  .reversed { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr); }
  .reversed .feature-copy { grid-column: 2; grid-row: 1; }
  .reversed .feature-visual { grid-column: 1; grid-row: 1; }
  .feature-list { display: grid; gap: 13px; list-style: none; padding: 0; margin: 0; }
  .feature-list li { display: flex; align-items: flex-start; gap: 10px; color: var(--text-muted); }
  .feature-list :global(svg) { color: var(--primary); margin-top: 4px; }
  .command-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .command-layout :global(.feature-grid) { grid-template-columns: minmax(0, 1fr); }
  .command-panel { min-width: 0; padding: 0; overflow: hidden; border-radius: var(--radius-lg); }
  .command-heading { display: flex; align-items: center; gap: 10px; padding: 16px 20px; border-bottom: 1px solid var(--border); color: var(--text-muted); }
  .command-heading :global(svg) { color: var(--primary); }
  pre { border: 0; border-radius: 0; padding: 24px; margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.7; color: var(--text); }
  .closing-sections { padding-block: 8px 56px; }
  .rar-note { display: flex; align-items: center; gap: 24px; border-radius: var(--radius-lg); }
  .rar-note .icon-badge { background: var(--surface); }
  .rar-note h2 { font-size: 1.25rem; margin-bottom: 8px; }
  .rar-note p { margin: 0; }
  .soon-section { padding-block: 48px; }
  .soon { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 0; }
  @media (max-width: 900px) {
    .feature-row, .reversed, .command-layout { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .reversed .feature-copy, .reversed .feature-visual { grid-column: auto; grid-row: auto; }
    .feature-visual { width: 100%; max-width: 760px; margin-inline: auto; }
  }
  @media (max-width: 600px) {
    .quick-jumps { gap: 8px; padding-block: 24px 12px; }
    .quick-jumps .pill-btn { padding-inline: 12px; }
    .rar-note { align-items: flex-start; gap: 16px; }
    .rar-note .icon-badge { width: 48px; height: 48px; }
    .rar-note .icon-badge :global(svg) { width: 28px; height: 28px; }
    pre { padding: 20px; }
    .soon-section { padding-block: 36px; }
    .closing-sections { padding-bottom: 36px; }
  }
</style>
