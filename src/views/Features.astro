          { icon: 'windows', title: 'Run in background', text: 'The Run in background button is in the progress window: minimize it and show a percentage on the taskbar icon.' },
          { icon: 'minus', title: 'Real pause', text: 'Pause / Resume pauses work in the engine. You can also cancel the operation.' },
          { icon: 'split', title: 'Sequential task queue', text: 'Issue commands while busy to queue them. Cancel one or all, remove completed entries and move tasks up or down in the queue window.' },
          { icon: 'file', title: 'Resolve file conflicts', text: 'Replace / Skip / Keep both / Rename… / Stop, with an Apply to all option.' },
          { icon: 'check', title: 'Clear results', text: 'Success / partial / error / stopped, with figures, Error details, Copy details and Open folder.' },
        ],
      },
      {
        id: 'test-info', icon: 'check', title: 'Test & information',
        lead: 'Check archive integrity and keep a report to review later.',
        screenshot: 'test-result', alt: 'GenZip archive integrity test results with statistics and report export',
        items: [
          { icon: 'check', title: 'Integrity testing', text: 'Total files, Tested, Completed, Errors, Skipped and Time.' },
          { icon: 'file', title: 'Export a .txt report', text: 'Export the test report as a .txt file or choose View details.' },
          { icon: 'eye', title: 'Archive information', text: 'Original and packed sizes, file and folder counts, encryption and percentage saved; Copy information is available.' },
        ],
      },
      {
        id: 'safety', icon: 'shield', title: 'Safety',
        lead: 'Extraction safeguards and a private experience in the Microsoft Store build.',
        items: [
          { icon: 'shield', title: 'Block dangerous paths', text: 'Blocks dangerous paths such as ../ and Windows device names.' },
          { icon: 'gear', title: 'Extraction limits', text: 'Limits for entry count, expansion ratio, size and folder depth.' },
          { icon: 'lock', title: 'Keep Mark of the Web', text: 'Preserves the Internet origin mark on extracted files, with controls in security settings.' },
          { icon: 'store', title: 'Privacy in the Store build', text: 'No network connections, no ads and no account required.' },
        ],
      },
      {
        id: 'windows-settings', icon: 'windows', title: 'Windows integration & settings',
        lead: 'Right-click commands in Windows and a separate settings window to tailor your workflow.',
        items: [
          { icon: 'windows', title: 'Windows 11 top-level menu', text: 'Open with GenZip; Extract files…; Extract here; Extract to "<name>\\"; Add to archive…; Add to "<name>.zip"; Add to "<name>.7z".' },
          { icon: 'menu', title: 'Classic menu', text: 'Quick compress to ZIP/7Z; Extract to a folder with the same name.' },
          { icon: 'file', title: 'Windows manages associations', text: 'File associations and the right-click menu are included in the Store package. Choose GenZip in Windows Default apps; the app cannot set itself as default. Extensions: .zip .7z .rar .tar .gz .bz2 .xz .zst .iso .cab .wim .001.' },
          { icon: 'gear', title: 'General', text: 'Language, recent file history and item count, clear history, list view style and visible columns.' },
          { icon: 'file', title: 'Compression & extraction', text: 'Default format, level 0–9 and compression method. Extraction destination: beside the archive / fixed folder / ask; existing file handling and opening the folder after extraction.' },
          { icon: 'sun', title: 'Appearance & security', text: 'System / Light / Dark, accent color and icon style. Security settings include keeping Mark of the Web and safety limits.' },
          { icon: 'store', title: 'Integration & updates', text: 'Integration says Windows manages the Microsoft Store build. Updates says Microsoft Store provides updates; there are no update channels or check button.' },
          { icon: 'gear', title: 'Advanced', text: 'Thread count, temporary folder, log level and a custom 7z.dll under the LGPL.' },
        ],
      },
    ] as Group[],
    cli: 'Basic command-line support.',
  },
}[lang];
---

<Base title={t('nav.features')} description={c.lead}>
  <PageHero eyebrow={c.eyebrow} title={c.title} lead={c.lead} />

  <div class="container">
    <nav class="contents" aria-label={c.toc}>
      <h2>{c.toc}</h2>
      <ul>
        {c.groups.map((group) => (
          <li><a href={`#${group.id}`}><Icon name={group.icon} size={18} /><span>{group.title}</span></a></li>
        ))}
        <li><a href="#formats"><Icon name="file" size={18} /><span>{c.formatsTitle}</span></a></li>
        <li><a href="#soon"><Icon name="plus" size={18} /><span>{c.soonTitle}</span></a></li>
      </ul>
    </nav>
  </div>

  {c.groups.map((group, index) => <FeatureGroup {...group} band={index % 2 === 1} />)}

  <section id="formats" class="section reference-section" aria-label={c.formatsTitle}>
    <div class="container">
      <SectionHeading title={c.formatsTitle} lead={c.formatsLead} align="left" />
      <FormatMatrix lang={lang} />
      <p class="cli muted">{c.cli}</p>
    </div>
  </section>

  <section id="soon" class="section reference-section band" aria-label={c.soonTitle}>
    <div class="container">
      <SectionHeading title={c.soonTitle} lead={c.soonLead} align="left" />
      <FeatureGrid items={c.soon} />
    </div>
  </section>
</Base>

<style>
  .contents { padding-block: 32px; }
  .contents h2 { font-size: 1rem; margin-bottom: 16px; }
  .contents ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px 20px; list-style: none; margin: 0; padding: 0; }
  .contents a { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-muted); font-size: 0.9375rem; }
  .contents a:hover { border-color: var(--primary); background: var(--accent-soft); text-decoration: none; }
  .contents :global(svg) { color: var(--primary); }
  .reference-section { scroll-margin-top: 96px; }
  .cli { margin: 20px 0 0; font-size: 0.9375rem; }
  @media (max-width: 900px) {
    .contents ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .contents { padding-block: 24px; }
    .contents ul { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  }
</style>
