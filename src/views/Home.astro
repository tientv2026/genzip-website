---
import Base from '../layouts/Base.astro';
import Screenshot from '../components/Screenshot.astro';
import Icon from '../components/ui/Icon.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CtaCard from '../components/ui/CtaCard.astro';
import { getLangFromUrl, localePath } from '../i18n/ui';
import { storeUrl } from '../data/product';

const lang = getLangFromUrl(Astro.url);
const p = (path: string) => localePath(path, lang);
const c = {
  vi: {
    badge: 'Dành cho Windows 10 / 11',
    title: 'Nén và giải nén nhanh, gọn,', highlight: 'an toàn.',
    lead: 'Mở RAR, ZIP, 7z và nhiều định dạng khác. Miễn phí, không quảng cáo, không thu thập dữ liệu.',
    store: 'Tải từ Microsoft Store', installer: 'Tải bộ cài .exe',
    meta: 'Windows 10/11 · 64-bit · Miễn phí', shotAlt: 'GenZip đang duyệt nội dung một tệp nén',
    opens: 'Mở tệp', creates: 'Tạo tệp', moreFormats: 'Xem tất cả định dạng',
    rarNote: 'Đọc và giải nén RAR · Không tạo tệp RAR',
    benefitsTitle: 'Mọi thứ cần thiết. Vừa đủ gọn gàng.',
    benefits: [
      { icon: 'bolt', title: 'Nhanh', text: 'Nén đa luồng, tạm dừng và tiếp tục khi cần.' },
      { icon: 'shield', title: 'An toàn', text: 'Chặn đường dẫn độc hại. Bảo vệ dữ liệu bằng mật khẩu.' },
      { icon: 'windows', title: 'Quen tay', text: 'Kéo thả, menu chuột phải và giao diện Windows.' },
    ],
    extractLabel: 'GIẢI NÉN', extractTitle: 'Một cú nhấp. Xong việc.',
    extractText: 'Giải nén ngay từ menu chuột phải. Chọn nơi lưu và cách xử lý khi trùng tệp.', guide: 'Xem hướng dẫn',
    archive: 'Du_lieu.zip', open: 'Mở', openWith: 'Mở bằng', share: 'Chia sẻ', copyPath: 'Sao chép đường dẫn', properties: 'Thuộc tính',
    extractHere: 'Giải nén tại đây', extractTo: 'Giải nén tới…', addArchive: 'Thêm vào tệp nén…',
    createLabel: 'TẠO & BẢO VỆ', createTitle: 'Gọn dung lượng. Giữ riêng tư.',
    createText: 'Tạo ZIP, 7z, TAR với cấu hình có sẵn. Bảo vệ dữ liệu bằng mật khẩu AES-256.',
    split: 'Chia nhỏ tệp', encrypt: 'Mã hóa tên tệp', background: 'Chạy nền',
    dialogTitle: 'Tạo tệp nén', filename: 'Tên tệp:', filenameValue: 'Tai_lieu.7z', format: 'Định dạng:',
    level: 'Mức nén:', normal: 'Thông thường', password: 'Mật khẩu:', backgroundAfter: 'Chạy nền sau khi tạo',
    privacyTitle: 'Tệp của bạn, luôn là của bạn.',
    privacyText: 'GenZip không quảng cáo, không thu thập dữ liệu và không yêu cầu tài khoản.',
    privacy: ['tài khoản', 'quảng cáo', 'theo dõi'], privacyLink: 'Chính sách quyền riêng tư',
    themeTitle: 'Giao diện theo cách của bạn.', themeText: 'Sáng, tối hoặc theo hệ thống. 9 màu nhấn để lựa chọn.',
    light: 'Giao diện sáng', dark: 'Giao diện tối', accentsLabel: '9 màu nhấn của GenZip',
    accents: ['Xanh dương', 'Chàm', 'Tím', 'Hồng', 'Đỏ', 'Cam', 'Vàng', 'Xanh lá', 'Xám'],
    faqTitle: 'Có thể bạn đang thắc mắc', allFaq: 'Xem tất cả câu hỏi',
    faq: [
      { q: 'GenZip có thực sự miễn phí?', a: 'Có. GenZip miễn phí và không có quảng cáo.' },
      { q: 'GenZip có tạo được tệp RAR không?', a: 'Không. GenZip chỉ đọc và giải nén RAR; bạn có thể tạo tệp ZIP, 7z và TAR.' },
      { q: 'Tôi nên tải bản cài đặt nào?', a: 'Microsoft Store được khuyên dùng để nhận cập nhật tự động. Bộ cài .exe cài cho người dùng hiện tại, không cần quyền quản trị. Bản portable .zip cho phép chạy mà không cần cài đặt.' },
    ],
    love: 'Yêu thích GenZip?', support: 'Ủng hộ tác giả',
  },
  en: {
    badge: 'For Windows 10 / 11', title: 'Compress and extract. Fast, clean,', highlight: 'safe.',
    lead: 'Open RAR, ZIP, 7z and many other formats. Free, with no ads and no data collection.',
    store: 'Get it from Microsoft Store', installer: 'Download .exe installer',
    meta: 'Windows 10/11 · 64-bit · Free', shotAlt: 'GenZip browsing the contents of an archive',
    opens: 'Open', creates: 'Create', moreFormats: 'See all formats', rarNote: 'Read and extract RAR · No RAR creation',
    benefitsTitle: 'Everything you need. Simply uncluttered.',
    benefits: [
      { icon: 'bolt', title: 'Fast', text: 'Multithreaded compression. Pause and resume whenever you need.' },
      { icon: 'shield', title: 'Safe', text: 'Blocks malicious paths. Protect your data with a password.' },
      { icon: 'windows', title: 'Familiar', text: 'Drag and drop, the right-click menu and a Windows interface.' },
    ],
    extractLabel: 'EXTRACT', extractTitle: 'One click. Job done.',
    extractText: 'Extract straight from the right-click menu. Choose where to save and how to handle duplicate files.', guide: 'View the guide',
    archive: 'Data.zip', open: 'Open', openWith: 'Open with', share: 'Share', copyPath: 'Copy as path', properties: 'Properties',
    extractHere: 'Extract here', extractTo: 'Extract to…', addArchive: 'Add to archive…',
    createLabel: 'CREATE & PROTECT', createTitle: 'Save space. Keep it private.',
    createText: 'Create ZIP, 7z and TAR with built-in presets. Protect your data with AES-256 password encryption.',
    split: 'Split files', encrypt: 'Encrypt file names', background: 'Run in background',
    dialogTitle: 'Create archive', filename: 'File name:', filenameValue: 'Documents.7z', format: 'Format:',
    level: 'Compression:', normal: 'Normal', password: 'Password:', backgroundAfter: 'Run in background after creation',
    privacyTitle: 'Your files. Always yours.', privacyText: 'GenZip has no ads, collects no data and requires no account.',
    privacy: ['accounts', 'ads', 'tracking'], privacyLink: 'Privacy policy',
    themeTitle: 'Make yourself at home.', themeText: 'Light, dark or follow your system. Choose from 9 accent colors.',
    light: 'Light theme', dark: 'Dark theme', accentsLabel: 'GenZip’s 9 accent colors',
    accents: ['Blue', 'Indigo', 'Purple', 'Pink', 'Red', 'Orange', 'Amber', 'Green', 'Slate'],
    faqTitle: 'You might be wondering', allFaq: 'See all questions',
    faq: [
      { q: 'Is GenZip really free?', a: 'Yes. GenZip is free and has no ads.' },
      { q: 'Can GenZip create RAR files?', a: 'No. GenZip only reads and extracts RAR archives; it can create ZIP, 7z and TAR files.' },
      { q: 'Which download should I choose?', a: 'Microsoft Store is recommended for automatic updates. The .exe installer installs for your user account without administrator rights. The portable .zip runs without installation.' },
    ],
    love: 'Enjoying GenZip?', support: 'Support the author',
  },
}[lang];
const accentTokens = ['blue', 'indigo', 'purple', 'pink', 'red', 'orange', 'amber', 'green', 'slate'];
---

<Base title="GenZip" description={c.lead}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="windows-badge"><Icon name="windows" size={20} />{c.badge}</span>
        <h1>{c.title} <span>{c.highlight}</span></h1>
        <p class="lead muted">{c.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href={storeUrl}><Icon name="windows" />{c.store}</a>
          <a class="btn btn-outline btn-lg" href={p('/download')}><Icon name="download" />{c.installer}</a>
        </div>
        <p class="meta muted">{c.meta}</p>
      </div>
      <div class="hero-shot">
        <div class="glow" aria-hidden="true"></div>
        <Screenshot name="main" alt={c.shotAlt} />
      </div>
    </div>
  </section>

  <section class="band formats" aria-label={c.moreFormats}>
    <div class="container formats-row">
      <div class="format-group">
        <span class="format-label">{c.opens}</span>
        {['RAR', 'ZIP', '7z', 'TAR', 'GZ', 'XZ', 'ISO'].map((f) => <span class="format-chip">{f}</span>)}
        <a class="format-chip more-formats" href={p('/features')} aria-label={c.moreFormats}><Icon name="plus" size={18} /></a>
      </div>
      <div class="format-group create-formats">
        <span class="format-label">{c.creates}</span>
        {['ZIP', '7z', 'TAR'].map((f) => <span class="format-chip">{f}</span>)}
      </div>
      <p class="rar-note muted">{c.rarNote}</p>
    </div>
  </section>

  <section class="section benefits-section">
    <div class="container">
      <SectionHeading title={c.benefitsTitle} />
      <div class="benefits">
        {c.benefits.map((b) => (
          <div class="benefit">
            <span class="icon-badge"><Icon name={b.icon} /></span>
            <div><h3>{b.title}</h3><p class="muted">{b.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="feature-section">
    <div class="container">
      <div class="extract-panel feature-row">
        <div class="feature-copy">
          <span class="eyebrow">{c.extractLabel}</span>
          <h2>{c.extractTitle}</h2>
          <p class="muted">{c.extractText}</p>
          <a class="text-link" href={p('/guide/extract')}>{c.guide}<Icon name="arrow-right" size={18} /></a>
        </div>
        <div class="wallpaper" aria-hidden="true">
          <div class="desktop-file"><img src="/brand/genzip-64.png" alt="" width="44" height="44" loading="lazy" /><span>{c.archive}</span></div>
          <div class="context-menu">
            <div class="menu-row"><Icon name="file" size={16} /><span>{c.open}</span><small>Enter</small></div>
            <div class="menu-row"><Icon name="folder" size={16} /><span>{c.openWith}</span><span>›</span></div>
            <div class="menu-row selected"><img src="/brand/genzip-32.png" alt="" width="18" height="18" loading="lazy" /><span>GenZip</span><span>›</span></div>
            <div class="menu-row"><Icon name="arrow-right" size={16} /><span>{c.share}</span></div>
            <div class="menu-row"><Icon name="key" size={16} /><span>{c.copyPath}</span></div>
            <div class="menu-row"><Icon name="gear" size={16} /><span>{c.properties}</span></div>
            <div class="sub-menu">
              <div class="menu-row selected"><Icon name="folder" size={16} /><span>{c.extractHere}</span></div>
              <div class="menu-row"><Icon name="folder" size={16} /><span>{c.extractTo}</span></div>
              <div class="menu-row"><Icon name="file" size={16} /><span>{c.addArchive}</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="feature-section create-section">
    <div class="container feature-row create-row">
      <div class="create-dialog" aria-hidden="true">
        <div class="dialog-bar"><img src="/brand/genzip-32.png" alt="" width="22" height="22" loading="lazy" /><strong>{c.dialogTitle}</strong><span>×</span></div>
        <div class="dialog-body">
          <span>{c.filename}</span><span class="mock-input">{c.filenameValue}</span>
          <span>{c.format}</span><div class="segments"><span>ZIP</span><span class="active">7z</span><span>TAR</span></div>
          <span>{c.level}</span><span class="mock-input level">{c.normal}<span>⌄</span></span>
          <span></span><span class="mock-check"><span class="checkbox checked"><Icon name="check" size={12} /></span>{c.encrypt}</span>
          <span>{c.password}</span><span class="mock-input password">••••••••••••••••<Icon name="eye" size={18} /></span>
          <span></span><div class="dialog-options"><span class="mock-check"><span class="checkbox"></span>{c.split}</span><span class="mock-check"><span class="checkbox"></span>{c.backgroundAfter}</span></div>
          <span></span><span class="mock-submit">{c.dialogTitle}</span>
        </div>
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{c.createLabel}</span>
        <h2>{c.createTitle}</h2>
        <p class="muted">{c.createText}</p>
        <div class="pills">
          <a class="pill-btn" href={p('/features')}><Icon name="split" />{c.split}</a>
          <a class="pill-btn" href={p('/features')}><Icon name="lock" />{c.encrypt}</a>
          <a class="pill-btn" href={p('/features')}><Icon name="gear" />{c.background}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="privacy-section">
    <div class="container">
      <div class="privacy card card-soft">
        <div class="privacy-copy">
          <span class="icon-badge"><Icon name="lock" /></span>
          <div><h2>{c.privacyTitle}</h2><p class="muted">{c.privacyText}</p></div>
        </div>
        <div class="privacy-stats">
          <div class="zeros">{c.privacy.map((label) => <span><strong>0</strong> {label}</span>)}</div>
          <a class="text-link" href={p('/privacy')}>{c.privacyLink}<Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="theme-section">
    <div class="container theme-grid">
      <div><h2>{c.themeTitle}</h2><p class="muted">{c.themeText}</p></div>
      <div>
        <div class="theme-shots">
          <figure><img src={`/screenshots/main-${lang}-light.png`} alt={`${c.shotAlt} — ${c.light}`} loading="lazy" decoding="async" /><figcaption class="muted">{c.light}</figcaption></figure>
          <figure><img src={`/screenshots/main-${lang}-dark.png`} alt={`${c.shotAlt} — ${c.dark}`} loading="lazy" decoding="async" /><figcaption class="muted">{c.dark}</figcaption></figure>
        </div>
        <ul class="accent-dots" aria-label={c.accentsLabel}>
          {accentTokens.map((token, i) => <li style={`--dot: var(--accent-${token})`} title={c.accents[i]}><span class="sr-only">{c.accents[i]}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <div class="faq-panel card">
        <div class="faq-heading"><h2>{c.faqTitle}</h2><a class="text-link" href={p('/faq')}>{c.allFaq}<Icon name="arrow-right" size={16} /></a></div>
        {c.faq.map((item, i) => <details class="faq-item" open={i === 0}><summary>{item.q}</summary><p>{item.a}</p></details>)}
      </div>
    </div>
  </section>

  <div class="container final-cta"><CtaCard /></div>
  <p class="support-line"><Icon name="heart" size={22} /><span>{c.love} <a href={p('/support')}>{c.support}<Icon name="arrow-right" size={16} /></a></span></p>
</Base>

<style>
  .hero { padding: 48px 0 52px; background: var(--hero-gradient); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 5fr 6fr; gap: 40px; align-items: center; }
  .hero-copy { min-width: 0; }
  .windows-badge { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 20px; padding: 6px 14px; border: 1px solid var(--border); border-radius: 999px; color: var(--accent-soft-text); background: var(--accent-soft); font-size: 0.8125rem; }
  h1 { font-size: clamp(2.5rem, 4.1vw, 3.5rem); line-height: 1.09; font-weight: 700; letter-spacing: -0.04em; margin-bottom: 20px; }
  h1 > span { color: var(--primary); display: block; }
  .lead { font-size: 1.125rem; max-width: 480px; line-height: 1.65; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 28px 0 16px; }
  .hero-actions .btn { font-size: 0.9375rem; padding-inline: 16px; }
  .meta { font-size: 0.8125rem; margin: 0; }
  .hero-shot { position: relative; min-width: 0; isolation: isolate; }
  .glow { position: absolute; inset: 0 -4% -6%; background: var(--brand-gradient); filter: blur(45px); opacity: 0.16; z-index: -1; }
  .formats { padding-block: 20px; }
  .formats-row { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; }
  .format-group { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .format-label { color: var(--primary); font-weight: 600; margin-right: 8px; white-space: nowrap; }
  .format-chip { display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 5px 13px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--primary); font-size: 0.8125rem; }
  .more-formats { min-width: 38px; min-height: 44px; padding: 5px; }
  .create-formats { border-left: 1px solid var(--border); padding-left: 24px; margin-left: auto; }
  .rar-note { font-size: 0.6875rem; margin: 0; }
  .benefits-section { padding-block: 44px; }
  .benefits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .benefit { display: flex; align-items: center; gap: 20px; }
  .benefit h3 { margin-bottom: 6px; }
  .benefit p { font-size: 0.9375rem; line-height: 1.5; margin: 0; }
  .feature-section { padding-block: 16px; }
  .feature-row { display: grid; grid-template-columns: 0.9fr 1.1fr; align-items: center; gap: 48px; }
  .feature-copy { min-width: 0; }
  .feature-copy h2 { font-size: clamp(1.65rem, 2.6vw, 2rem); font-weight: 700; }
  .feature-copy p { font-size: 1.0625rem; margin-bottom: 22px; max-width: 460px; }
  .text-link { display: inline-flex; align-items: center; gap: 7px; }
  .extract-panel { padding: 20px 20px 20px 24px; border-radius: var(--radius-lg); background: var(--hero-gradient); border: 1px solid var(--subtle); }
  .wallpaper { position: relative; min-height: 266px; background: linear-gradient(135deg, var(--band), var(--wallpaper)); border-radius: var(--radius); overflow: hidden; isolation: isolate; }
  .wallpaper::before, .wallpaper::after { content: ''; position: absolute; width: 140%; height: 120%; border-radius: 50%; border: 32px solid color-mix(in srgb, var(--wallpaper-wave) 65%, transparent); transform: rotate(-28deg); left: 10%; top: 34%; z-index: -1; box-shadow: 0 0 32px var(--wallpaper-wave), inset 0 0 25px var(--wallpaper-wave); }
  .wallpaper::after { left: 20%; top: 55%; border-width: 20px; }
  .desktop-file { position: absolute; top: 18px; left: 4%; width: 80px; padding: 8px 4px; display: grid; justify-items: center; gap: 5px; background: color-mix(in srgb, var(--accent-soft) 60%, transparent); border: 1px solid var(--border); border-radius: 5px; font-size: 0.6875rem; }
  .context-menu, .sub-menu { background: color-mix(in srgb, var(--surface) 96%, transparent); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 5px; box-shadow: var(--shadow); }
  .context-menu { position: absolute; top: 25px; left: 18%; width: 44%; font-size: 0.6875rem; }
  .menu-row { display: flex; align-items: center; gap: 10px; min-height: 33px; padding: 5px 8px; border-radius: 5px; line-height: 1.3; }
  .menu-row > span:nth-child(2) { flex: 1; }
  .menu-row small { font-size: 0.625rem; color: var(--text-muted); }
  .menu-row.selected { background: var(--accent-soft); }
  .menu-row :global(svg) { color: var(--accent-soft-text); }
  .sub-menu { position: absolute; left: 96%; top: 72px; width: 90%; }
  .sub-menu .menu-row { gap: 8px; padding-inline: 5px; }
  .create-section { padding-block: 4px 24px; }
  .create-row { grid-template-columns: 1fr 1fr; }
  .create-dialog { width: 100%; max-width: 540px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); font-size: 0.75rem; }
  .dialog-bar { display: flex; align-items: center; gap: 8px; padding: 10px 12px; background: var(--hero-gradient); border-radius: var(--radius) var(--radius) 0 0; }
  .dialog-bar > span { margin-left: auto; color: var(--text-muted); font-size: 1.25rem; }
  .dialog-bar strong { font-weight: 600; }
  .dialog-body { display: grid; grid-template-columns: 86px minmax(0, 1fr); align-items: center; gap: 9px 12px; padding: 12px 16px 16px; }
  .mock-input { min-height: 30px; display: flex; align-items: center; padding: 4px 10px; border: 1px solid var(--border); border-radius: 5px; }
  .segments { display: flex; gap: 5px; }
  .segments > span { min-width: 60px; text-align: center; padding: 6px 12px; border: 1px solid var(--border); border-radius: 5px; }
  .segments .active { background: var(--primary); border-color: var(--primary); color: var(--on-primary); }
  .level { max-width: 230px; justify-content: space-between; }
  .password { justify-content: space-between; }
  .mock-check { display: inline-flex; gap: 6px; align-items: center; line-height: 1.4; }
  .checkbox { width: 15px; height: 15px; border: 1px solid var(--border); border-radius: 3px; display: inline-grid; place-items: center; flex-shrink: 0; }
  .checked { background: var(--primary); border-color: var(--primary); color: var(--on-primary); }
  .dialog-options { display: flex; flex-wrap: wrap; gap: 8px 14px; font-size: 0.6875rem; }
  .mock-submit { display: block; text-align: center; padding: 8px; border-radius: var(--radius-sm); background: var(--primary); color: var(--on-primary); font-weight: 600; font-size: 0.9375rem; }
  .pills { display: flex; flex-wrap: wrap; gap: 12px; }
  .privacy-section { padding-block: 0 20px; }
  .privacy { display: grid; grid-template-columns: 0.95fr 1.2fr; gap: 28px; padding: 24px; border-radius: var(--radius-lg); }
  .privacy-copy { display: flex; align-items: center; gap: 20px; }
  .privacy h2 { font-size: 1.25rem; margin-bottom: 5px; }
  .privacy p { margin: 0; font-size: 0.875rem; }
  .privacy-stats { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 12px; border-left: 1px solid var(--border); padding-left: 24px; }
  .zeros { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 12px; width: 100%; }
  .zeros > span { font-size: 1.0625rem; font-weight: 600; white-space: nowrap; }
  .zeros strong { color: var(--primary); font-size: 2.25rem; line-height: 1; font-weight: 700; }
  .privacy-stats a { font-size: 0.875rem; }
  .theme-section { padding-block: 0 20px; }
  .theme-grid { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: 40px; align-items: center; }
