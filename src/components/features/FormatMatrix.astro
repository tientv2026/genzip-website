---
import { formats } from '../../data/product';

interface Props { lang: 'vi' | 'en' }
const { lang } = Astro.props;
const c = {
  vi: {
    caption: 'Khả năng theo định dạng · GenZip 0.9.0-beta.1',
    headers: ['Định dạng', 'Đọc / giải nén', 'Tạo', 'Sửa', 'Mã hoá'],
    yes: 'Có', no: 'Không',
    sevenZip: 'AES-256; ẩn tên tệp',
    split: 'Tệp chia phần .001 / .zip.001 / .7z.001',
    note: 'Sửa = thêm, xoá, đổi tên trong tệp nén. Ngoài các định dạng trên, GenZip đọc và giải nén .exe tự giải nén 7Z; có thể tạo .exe từ 7Z không chia phần.',
  },
  en: {
    caption: 'Capabilities by format · GenZip 0.9.0-beta.1',
    headers: ['Format', 'Read / extract', 'Create', 'Edit', 'Encrypt'],
    yes: 'Yes', no: 'No',
    sevenZip: 'AES-256; hide file names',
    split: 'Split archives .001 / .zip.001 / .7z.001',
    note: 'Edit = add, delete and rename inside an archive. In addition to the formats above, GenZip reads and extracts 7Z self-extracting .exe files, and can create them from unsplit 7Z.',
  },
}[lang];

const rows = formats.read.map((format) => ({
  name: format === '.001' ? c.split : format,
  create: formats.create.includes(format) ? c.yes : c.no,
  edit: formats.edit.includes(format) ? c.yes : c.no,
  encrypt: format === 'ZIP' ? 'ZipCrypto / AES-256' : format === '7z' ? c.sevenZip : c.no,
}));
---

<div class="matrix">
  <table>
    <caption>{c.caption}</caption>
    <thead><tr>{c.headers.map((heading) => <th scope="col">{heading}</th>)}</tr></thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.name}</th>
          {[c.yes, row.create, row.edit, row.encrypt].map((value, index) => (
            <td data-label={c.headers[index + 1]} class:list={{ supported: value === c.yes }}><span>{value}</span></td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="matrix-note muted">{c.note}</p>

<style>
  .matrix { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--surface); }
  table { border-collapse: collapse; width: 100%; table-layout: fixed; font-size: 0.9375rem; }
  caption { padding: 16px 20px; text-align: left; color: var(--text-muted); background: var(--subtle); }
  th, td { text-align: left; padding: 12px 16px; border-top: 1px solid var(--border); overflow-wrap: anywhere; vertical-align: top; }
  th { font-weight: 600; }
  thead { background: var(--band); }
  td { color: var(--text-muted); }
  .supported { color: var(--accent-soft-text); font-weight: 600; }
  .matrix-note { margin: 16px 0 0; font-size: 0.875rem; max-width: 900px; }
  @media (max-width: 600px) {
    table, tbody { display: block; }
    caption { display: block; }
    thead { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); }
    tr { display: block; border-top: 1px solid var(--border); padding: 12px 16px; }
    th[scope='row'] { display: block; padding: 0 0 8px; border: 0; }
    td { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; border: 0; padding: 4px 0; }
    td::before { content: attr(data-label); color: var(--text-muted); font-weight: 400; }
    td span { min-width: 0; }
  }
</style>
