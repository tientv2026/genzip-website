---
import { getLangFromUrl, localePath } from '../../i18n/ui';
import Icon from './Icon.astro';

const lang = getLangFromUrl(Astro.url);
const c = {
  vi: { title: 'Sẵn sàng dùng thử GenZip?', lead: 'Nén gọn hơn. Làm việc nhẹ nhàng hơn.', button: 'Tải miễn phí' },
  en: { title: 'Ready to try GenZip?', lead: 'Smaller archives. A smoother workflow.', button: 'Download free' },
}[lang];
---

<section class="cta-card card card-soft">
  <img src="/brand/genzip-128.png" alt="" width="64" height="64" loading="lazy" />
  <div>
    <h2>{c.title}</h2>
    <p class="muted">{c.lead}</p>
  </div>
  <a class="btn btn-primary btn-lg" href={localePath('/download', lang)}><Icon name="windows" />{c.button}</a>
</section>

<style>
  .cta-card { display: flex; align-items: center; gap: 24px; padding: 24px; border-radius: var(--radius-lg); }
  h2 { font-size: 1.5rem; margin: 0 0 4px; }
  p { margin: 0; }
  a { margin-left: auto; flex-shrink: 0; }
  @media (max-width: 700px) {
    .cta-card { flex-wrap: wrap; gap: 16px; }
    .cta-card > div { flex: 1; min-width: 180px; }
    a { margin-left: 0; width: 100%; }
  }
</style>
