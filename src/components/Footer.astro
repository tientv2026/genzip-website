---
import { getLangFromUrl, localePath, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localePath(path, lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <a class="brand" href={p('/')}>
        <img src="/brand/genzip-64.png" alt="" width="28" height="28" />
        <span>GenZip</span>
      </a>
      <p class="muted">{t('site.tagline')}.</p>
    </div>
    <div>
      <h4>{t('footer.product')}</h4>
      <a href={p('/features')}>{t('nav.features')}</a>
      <a href={p('/download')}>{t('nav.download')}</a>
      <a href={p('/changelog')}>{t('footer.changelog')}</a>
      <a href={p('/news')}>{t('nav.news')}</a>
    </div>
    <div>
      <h4>{t('footer.help')}</h4>
      <a href={p('/guide')}>{t('nav.guide')}</a>
      <a href={p('/faq')}>{t('nav.faq')}</a>
      <a href={p('/contact')}>{t('footer.contact')}</a>
      <a href={p('/support')}>{t('nav.support')}</a>
    </div>
    <div>
      <h4>{t('footer.legal')}</h4>
      <a href={p('/privacy')}>{t('footer.privacy')}</a>
      <a href={p('/terms')}>{t('footer.terms')}</a>
      <a href={p('/licenses')}>{t('footer.licenses')}</a>
    </div>
    <div class="bottom muted">
      <span>© {year} Dạ Trư · GenZip</span>
      <span>{t('footer.engine')}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    margin-top: 0;
    padding: 28px 0;
    font-size: 0.8125rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr) 2.2fr;
    gap: 24px;
  }
  .grid > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h4 {
    font-size: 0.875rem;
    margin-bottom: 4px;
  }
  .grid a {
    color: var(--text-muted);
  }
  .grid a:hover {
    color: var(--primary);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text) !important;
    font-weight: 600;
    font-size: 1.2rem;
    text-decoration: none;
  }
  .bottom {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 8px;
    font-size: 0.75rem;
    text-align: right;
  }
  @media (max-width: 1000px) {
    .grid { grid-template-columns: 1.5fr repeat(3, 1fr); }
    .grid .bottom { grid-column: 1 / -1; align-items: flex-start; text-align: left; }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
