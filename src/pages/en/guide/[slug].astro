---
import { getCollection } from 'astro:content';
import GuidePage from '../../../views/GuidePage.astro';

export async function getStaticPaths() {
  const docs = await getCollection('guide', (e) => e.id.startsWith('en/'));
  return docs.map((entry) => ({ params: { slug: entry.id.split('/')[1] }, props: { entry } }));
}

const { entry } = Astro.props;
---

<GuidePage entry={entry} />
